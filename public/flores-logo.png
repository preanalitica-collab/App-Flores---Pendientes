<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 880 330" width="880" height="330" fill="none">
  <defs>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@500;800;900&amp;display=swap');
      .brand-title {
        font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        font-weight: 900;
        font-size: 106px;
        fill: #000000;
        letter-spacing: -0.01em;
      }
      .brand-sub {
        font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        font-weight: 500;
        font-size: 68px;
        fill: #000000;
        letter-spacing: -0.02em;
      }
    </style>
  </defs>

  <!-- Isotipo: Hexágono oficial con puntas redondeadas -->
  <path
    d="M 98 22
       L 232 22
       C 256 22 278 35 290 56
       L 322 144
       C 328 156 328 174 322 186
       L 290 274
       C 278 295 256 308 232 308
       L 98 308
       C 74 308 52 295 40 274
       L 8 186
       C 2 174 2 156 8 144
       L 40 56
       C 52 35 74 22 98 22 Z"
    fill="#612660"
  />

  <!-- Isotipo: F blanca institucional -->
  <path
    d="M 96 244
       L 138 244
       L 138 182
       L 204 182
       L 204 146
       L 138 146
       L 138 112
       C 138 92 152 82 172 82
       L 234 82
       L 234 46
       L 168 46
       C 122 46 96 72 96 122
       Z"
    fill="#FFFFFF"
  />

  <!-- Texto: FLORES -->
  <text x="368" y="162" class="brand-title">FLORES</text>

  <!-- Texto: Laboratorios -->
  <text x="372" y="246" class="brand-sub">Laboratorios</text>
</svg>
